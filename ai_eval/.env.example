# Copy to .env and fill in, then pass --env-file .env to the CLI.
# This file is an example. It is not loaded automatically. Do not put real keys here.

# mock (default when unset) makes no provider call. live calls the configured endpoint.
AI_EVAL_MODE=mock

# Bounded attempts per request for timeouts, rate limits, and 5xx. SDK retries are off.
AI_EVAL_MAX_ATTEMPTS=3

# Each role is configured on its own. There is no default model id and no default URL.
# Omit a generation setting when that model does not support it.

AI_EVAL_JUDGE_A_BASE_URL=https://PASTE
AI_EVAL_JUDGE_A_API_KEY_ENV=AI_EVAL_JUDGE_A_API_KEY
AI_EVAL_JUDGE_A_API_KEY=PASTE
AI_EVAL_JUDGE_A_MODEL=PASTE
# json_schema or json_object. Required in live mode. A rejected format is an error, not a fallback.
AI_EVAL_JUDGE_A_RESPONSE_FORMAT=json_schema
AI_EVAL_JUDGE_A_TIMEOUT_SECONDS=60
AI_EVAL_JUDGE_A_MAX_OUTPUT_TOKENS=2000
# max_completion_tokens (default) or max_tokens, depending on the endpoint.
AI_EVAL_JUDGE_A_MAX_TOKENS_PARAM=max_completion_tokens
# Optional. Delete the line when the model does not support the setting.
# A rejected setting is reported as a configuration error naming the variable.
# TEMPERATURE=0 makes judge comparisons reproducible on models that accept it.
# AI_EVAL_JUDGE_A_TEMPERATURE=0
# AI_EVAL_JUDGE_A_REASONING_EFFORT=

# Judge B should be a different model/vendor from judge A so the two judgments are independent.
# Any OpenAI-compatible Chat Completions endpoint works (e.g. Anthropic's compatibility
# endpoint for Claude). Use prompt_json when the endpoint's response_format support is unknown.
AI_EVAL_JUDGE_B_BASE_URL=https://PASTE
AI_EVAL_JUDGE_B_API_KEY_ENV=AI_EVAL_JUDGE_B_API_KEY
AI_EVAL_JUDGE_B_API_KEY=PASTE
AI_EVAL_JUDGE_B_MODEL=PASTE
AI_EVAL_JUDGE_B_RESPONSE_FORMAT=prompt_json
AI_EVAL_JUDGE_B_TIMEOUT_SECONDS=120
AI_EVAL_JUDGE_B_MAX_OUTPUT_TOKENS=4000
AI_EVAL_JUDGE_B_MAX_TOKENS_PARAM=max_tokens
# AI_EVAL_JUDGE_B_TEMPERATURE=
# AI_EVAL_JUDGE_B_REASONING_EFFORT=

# Adjudicator runs only for criteria the two judges disagreed on. It can reuse
# another role's key by naming that variable in API_KEY_ENV.
AI_EVAL_ADJUDICATOR_BASE_URL=https://PASTE
AI_EVAL_ADJUDICATOR_API_KEY_ENV=AI_EVAL_ADJUDICATOR_API_KEY
AI_EVAL_ADJUDICATOR_API_KEY=PASTE
AI_EVAL_ADJUDICATOR_MODEL=PASTE
AI_EVAL_ADJUDICATOR_RESPONSE_FORMAT=prompt_json
AI_EVAL_ADJUDICATOR_TIMEOUT_SECONDS=120
AI_EVAL_ADJUDICATOR_MAX_OUTPUT_TOKENS=1200
AI_EVAL_ADJUDICATOR_MAX_TOKENS_PARAM=max_tokens
# AI_EVAL_ADJUDICATOR_TEMPERATURE=
# AI_EVAL_ADJUDICATOR_REASONING_EFFORT=

# Optional USD price per 1M tokens. Leave both unset when the price is unknown.
# Do not invent a price. One side without the other is a configuration error.
# Estimated cost is computed only from reported token counts and these values.
# It is not the provider-billed cost.
# AI_EVAL_PRICE_INPUT_PER_MILLION=
# AI_EVAL_PRICE_OUTPUT_PER_MILLION=
