# Copy to .env and fill in.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
# DATABASE_URL=postgres://cqa:cqa@localhost:5432/cqa   (default: SQLite db.sqlite3)

# Organizers' dataset API: the GET link without the group_id parameter.
CQA_DATASET_API_URL=

# LLM: "anthropic" (needs ANTHROPIC_API_KEY) or "mock" (fake verdicts, no key).
CQA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CQA_MODEL_AGENT_A=claude-opus-5-5
CQA_MODEL_AGENT_B=claude-opus-5-5
CQA_MODEL_ARBITER=claude-opus-5-5
CQA_EFFORT_AGENT=medium
CQA_EFFORT_ARBITER=high
CQA_USE_FALLBACKS=true

# Background execution: "thread" (in-process, no Redis) or "celery".
CQA_EXECUTOR=thread
CQA_MAX_CONCURRENCY=4
# CELERY_BROKER_URL=redis://localhost:6379/0

# Comma-separated frontend origins (e.g. the Dynamics 365 org URL). Empty + DEBUG = allow all.
CORS_ALLOWED_ORIGINS=
