# Copy to .env and fill in. NEVER commit .env (the repo is public).

# --- Organizer API (full DEV link WITHOUT the &group_id=... part) ---
CQA_API_BASE=https://PASTE.environment.api.powerplatform.com/powerautomate/.../invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=PASTE
CQA_GROUP_ID=DEV
# Optional: load from a local file instead of the API (e.g. data/dev.json)
CQA_DATA_FILE=

# --- LLM (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-PASTE
LLM_MODEL=gpt-5-mini
# low | medium | high  (only sent for reasoning models; leave empty otherwise)
LLM_REASONING_EFFORT=low
# How many independent runs per conversation; answers are majority-voted (1 = fastest)
LLM_VOTES=1
# Price per 1M tokens, for the cost display
LLM_PRICE_IN=0.25
LLM_PRICE_OUT=2.00
# Set to 0 if the endpoint does not support response_format json_schema (some local models)
LLM_STRICT_SCHEMA=1

# Evaluation mode: "single" (one call; LLM_VOTES>1 = majority vote) or "ensemble"
# (evaluators A "rule-first" + B "evidence-first" in parallel, an arbiter call only on the
# criteria they disagree on; about 2-3x the cost of single). Check with `npm run eval` first.
LLM_MODE=single
# Optional, ensemble only: a different model for B / the arbiter (less correlated mistakes)
LLM_MODEL_B=
LLM_MODEL_ARBITER=

# Gemini (your Google AI Studio key) through its OpenAI-compatible endpoint.
# Not tested by us with this app yet. If you get a response_format / schema error, set LLM_STRICT_SCHEMA=0.
# Free tier is slow and Google may use the data; prices below are the paid list price (Nov 2026).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your_gemini_key
# LLM_MODEL=gemini-3.8-flash
# LLM_REASONING_EFFORT=
# LLM_PRICE_IN=0.75
# LLM_PRICE_OUT=3.75

# Operators page: the organizers' data has no operator names and no chat dates, so each conversation
# gets a demo name + date (stable per conversation, marked "демо" in the UI). Real fields in the data win.
# 0 = off.
DEMO_OPERATORS=1

# Voice pipeline output (voice/to_gemini.py --out ...): voice/<id>.json + audio/<id>.mp3
VOICE_OUT_DIR=voice/out

# Backup: NVIDIA NIM
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
# Local: Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:14b
# LLM_STRICT_SCHEMA=0

# Use a fake LLM (no API calls) for UI work and tests
LLM_MOCK=0

PORT=3000
